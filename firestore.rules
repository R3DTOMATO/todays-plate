rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 오늘의 식탁 — Firestore 보안 규칙
//
// 원칙
//  1. 기본은 차단. 명시적으로 허용한 경로만 열린다.
//  2. 자기 문서만 쓸 수 있다. 남의 이름으로 투표하거나 프로필을 바꿀 수 없다.
//  3. 삭제는 클라이언트에서 금지한다. 필요한 삭제는 관리자/서버가 처리한다.
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 "게시"
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 공통 함수 ───

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 문자열 필드가 존재하고 길이 제한을 지키는지 확인
    function validName(value) {
      return value is string && value.size() > 0 && value.size() <= 12;
    }

    // ─── 사용자 프로필 ───
    // 피드·투표에서 표시 이름이 보여야 하므로 로그인 사용자에게 읽기를 허용한다.
    // 이메일은 애초에 저장하지 않으므로 노출 위험이 없다.

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSelf(userId)
                    && validName(request.resource.data.displayName);

      allow update: if isSelf(userId)
                    && validName(request.resource.data.displayName)
                    // uid를 바꿔치기할 수 없게 고정
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['displayName', 'photoUrl', 'feedPublicDefault']);

      // 탈퇴 시 문서 삭제는 서버(Cloud Functions)에서 처리한다
      allow delete: if false;

      // 저장한 게시물 — 본인만 읽고 쓸 수 있다
      match /savedPosts/{postId} {
        allow read, create, delete: if isSelf(userId);
        allow update: if false;
      }

      // 차단한 사용자 — 본인만 읽고 쓸 수 있다
      match /blockedUsers/{blockedUid} {
        allow read, create, delete: if isSelf(userId);
        allow update: if false;
      }
    }

    // ─── 그룹 투표 ───

    match /voteSessions/{sessionId} {

      function session() {
        return get(/databases/$(database)/documents/voteSessions/$(sessionId)).data;
      }

      // 세션 ID는 12자 랜덤이므로 링크를 아는 사람만 사실상 접근 가능하다.
      // 규칙만으로 "링크를 아는 사람"을 표현할 수 없어 로그인 여부로 제한한다.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.candidates.size() >= 2
                    && request.resource.data.candidates.size() <= 5
                    && request.resource.data.closesAt > request.time;

      // 마감 처리는 주최자만 할 수 있다
      allow update: if isSignedIn()
                    && resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostUid == resource.data.hostUid;

      allow delete: if false;

      match /participants/{participantUid} {
        allow read: if isSignedIn();

        // 문서 ID가 곧 uid이므로, 자기 문서만 만들 수 있다 → 1인 1표가 구조적으로 보장된다
        allow create: if isSelf(participantUid)
                      && session().status == 'open'
                      && session().closesAt > request.time
                      && validName(request.resource.data.name);

        // 마감 시각이 지나면 투표를 바꿀 수 없다.
        // 주최자가 status를 못 바꾼 경우에도 시각으로 막힌다.
        allow update: if isSelf(participantUid)
                      && session().status == 'open'
                      && session().closesAt > request.time
                      && validName(request.resource.data.name);

        allow delete: if false;
      }
    }

    // ─── 소셜 피드 게시물 ───

    match /posts/{postId} {
      allow read: if isSignedIn() && resource.data.status == 'visible';

      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'visible'
                    // 집계값을 임의로 부풀린 채 생성할 수 없다
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.reportCount == 0
                    && request.resource.data.memo.size() <= 300
                    && request.resource.data.menuName.size() > 0;

      function likeRef() {
        return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      }

      function onlyChanged(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // 작성자 본문 수정
      function authorEdit() {
        return resource.data.authorUid == request.auth.uid
               && request.resource.data.authorUid == resource.data.authorUid
               && onlyChanged(['memo', 'photoUrl', 'photoPath']);
      }

      // 좋아요 카운터 조정.
      // 규칙은 트랜잭션 이전 상태로 평가되므로, 좋아요 문서의 유무로
      // 같은 사람이 반복해서 +1 하는 것을 막을 수 있다.
      function likeToggle() {
        return onlyChanged(['likeCount'])
               && (
                 (request.resource.data.likeCount == resource.data.likeCount + 1
                  && !exists(likeRef()))
                 ||
                 (request.resource.data.likeCount == resource.data.likeCount - 1
                  && exists(likeRef()))
               );
      }

      // reportCount는 어느 쪽으로도 클라이언트가 바꿀 수 없다.
      // 신고 집계는 서버(Cloud Functions)가 담당한다.
      allow update: if isSignedIn() && (authorEdit() || likeToggle());

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      // 좋아요 — 문서 ID가 uid이므로 한 사람이 한 번만 누를 수 있다
      match /likes/{likeUid} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(likeUid);
        allow update: if false;
      }

      // 댓글
      match /comments/{commentId} {
        allow read: if isSignedIn() && resource.data.status == 'visible';

        allow create: if isSignedIn()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.status == 'visible'
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300;

        // 댓글은 수정하지 않는다. 고치려면 지우고 다시 쓴다.
        allow update: if false;

        allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    // ─── 신고 ───
    // 신고자 보호를 위해 아무도 읽을 수 없다. 본인이 낸 신고도 다시 못 본다.
    // 검토는 Admin SDK를 쓰는 운영 도구에서만 한다.

    match /reports/{reportId} {
      allow read: if false;

      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.targetType in ['post', 'comment', 'user']
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.reason in
                       ['spam', 'inappropriate', 'notFood', 'harassment', 'falseInfo', 'other']
                    && request.resource.data.detail.size() <= 300;

      // 신고는 접수 후 수정·삭제할 수 없다. 처리는 서버가 한다.
      allow update, delete: if false;
    }

    // ─── 명시하지 않은 모든 경로는 차단 ───
    // 위에서 허용한 경로 외에는 읽기·쓰기가 모두 막힌다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
