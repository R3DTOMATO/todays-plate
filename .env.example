# Local development only. Do not commit a real .env file.
PORT=8787
# Naver Developers application with Search enabled
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Naver Cloud Maps application with Geocoding / Reverse Geocoding enabled
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DATA_DIR=server/data
RATE_LIMIT_PER_MINUTE=120
DATA_RETENTION_DAYS=90
# BACKUP_DIR=/app/server/data/backups
